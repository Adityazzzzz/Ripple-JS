---
// Footer.astro — Page navigation footer
---

<div class="mt-16 pt-8 border-t border-gray-100">
  <div class="flex items-center justify-between text-sm">
    <a href="#" class="group flex items-center gap-2 text-gray-500 hover:text-orange-500 transition-colors">
      <svg class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      <span>Previous</span>
    </a>
    <a href="#" class="group flex items-center gap-2 text-gray-500 hover:text-orange-500 transition-colors">
      <span>Next</span>
      <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
  
  <div class="mt-8 pb-8 text-center text-xs text-gray-400">
    <p>Ripple.js — A standalone reactive utility library</p>
    <p class="mt-1">MIT License · Built with ❤️</p>
  </div>
</div>
