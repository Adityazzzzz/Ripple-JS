---
import TopNav from '../components/TopNav.astro';

const features = [
  { icon: '⚡', title: 'Signals', desc: 'Reactive values that automatically track dependencies and notify subscribers.' },
  { icon: '🧮', title: 'Computed', desc: 'Derived values that lazily re-evaluate only when their dependencies change.' },
  { icon: '🔄', title: 'Effects', desc: 'Side effects that auto-track and re-run when their reactive dependencies update.' },
  { icon: '📦', title: 'Zero Deps', desc: 'No runtime dependencies. Works in Node, browsers, Deno — anywhere JS runs.' },
  { icon: '🔌', title: 'Framework Adapters', desc: 'First-class hooks for React, Vue 3, and Svelte. Drop into existing projects.' },
  { icon: '🪶', title: '~3.5KB Gzipped', desc: 'Tiny bundle. Every utility tree-shakes independently for minimal impact.' },
];
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ripple.js — Standalone Reactive Utility Library</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-white text-gray-800 font-sans antialiased">

  <TopNav />

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-orange-50 via-white to-amber-50"></div>
    <div class="relative max-w-5xl mx-auto px-6 pt-20 pb-24 text-center">
      <div class="inline-flex items-center gap-2 bg-orange-50 border border-orange-200 text-orange-600 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
        <span class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></span>
        v0.1.0 — Now available on npm
      </div>
      
      <h1 class="text-5xl lg:text-6xl font-black text-gray-900 tracking-tight leading-tight mb-6">
        One change<br/>
        <span class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent">ripples through all.</span>
      </h1>
      
      <p class="text-xl text-gray-500 max-w-2xl mx-auto mb-10 leading-relaxed">
        Standalone reactive signals, computed values, and effects — no framework required. 
        Plug them into anything.
      </p>

      <div class="flex items-center justify-center gap-4 mb-16">
        <a href="/getting-started/introduction" class="px-6 py-3 bg-orange-500 hover:bg-orange-600 text-white font-semibold rounded-xl shadow-lg shadow-orange-500/25 hover:shadow-xl hover:shadow-orange-500/30 transition-all">
          Get Started →
        </a>
        <div class="flex items-center gap-2 px-5 py-3 bg-gray-900 text-gray-300 rounded-xl font-mono text-sm">
          <span class="text-gray-500">$</span>
          <span>npm install ripple-reactive</span>
          <button class="ml-2 text-gray-500 hover:text-white transition-colors" title="Copy">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
          </button>
        </div>
      </div>

      <!-- Hero Code Preview -->
      <div class="max-w-2xl mx-auto">
        <div class="rounded-2xl overflow-hidden shadow-2xl shadow-gray-900/10 border border-gray-200">
          <div class="bg-gradient-to-r from-orange-500 via-orange-400 to-amber-400 px-5 py-3 flex items-center gap-2">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-white/30"></div>
              <div class="w-3 h-3 rounded-full bg-white/30"></div>
              <div class="w-3 h-3 rounded-full bg-white/30"></div>
            </div>
            <span class="text-white/90 text-sm font-medium ml-2">quick-example.ts</span>
          </div>
          <div class="bg-gray-950 p-6 text-left">
            <pre class="text-sm leading-relaxed"><code class="text-gray-300"><span class="text-purple-400">import</span> {'{'} <span class="text-orange-300">signal</span>, <span class="text-orange-300">computed</span>, <span class="text-orange-300">effect</span> {'}'} <span class="text-purple-400">from</span> <span class="text-green-400">'ripple-reactive'</span>;

<span class="text-purple-400">const</span> <span class="text-blue-300">count</span> = <span class="text-orange-300">signal</span>(<span class="text-amber-300">0</span>);
<span class="text-purple-400">const</span> <span class="text-blue-300">doubled</span> = <span class="text-orange-300">computed</span>(() => <span class="text-blue-300">count</span>.<span class="text-cyan-300">value</span> * <span class="text-amber-300">2</span>);

<span class="text-orange-300">effect</span>(() => {'{'} 
  console.<span class="text-cyan-300">log</span>(<span class="text-green-400">`Count: ${'{'}<span class="text-blue-300">count</span>.<span class="text-cyan-300">value</span>{'}'}, Doubled: ${'{'}<span class="text-blue-300">doubled</span>.<span class="text-cyan-300">value</span>{'}'}`</span>);
{'}'});
<span class="text-gray-500">// → "Count: 0, Doubled: 0"</span>

<span class="text-blue-300">count</span>.<span class="text-cyan-300">value</span> = <span class="text-amber-300">5</span>;
<span class="text-gray-500">// → "Count: 5, Doubled: 10"  ✨ automatic!</span></code></pre>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="max-w-5xl mx-auto px-6 py-20">
    <h2 class="text-3xl font-bold text-gray-900 text-center mb-4">Everything you need</h2>
    <p class="text-gray-500 text-center mb-12 max-w-xl mx-auto">A complete reactive toolkit with signals, state management, async resources, and framework adapters — all in under 4KB.</p>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((f) => (
        <div class="p-6 rounded-xl border border-gray-100 hover:border-orange-200 hover:shadow-lg hover:shadow-orange-500/5 transition-all group">
          <div class="text-3xl mb-3">{f.icon}</div>
          <h3 class="font-bold text-gray-900 mb-2 group-hover:text-orange-600 transition-colors">{f.title}</h3>
          <p class="text-sm text-gray-500 leading-relaxed">{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-gradient-to-r from-orange-500 to-amber-500 py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-bold text-white mb-4">Ready to get started?</h2>
      <p class="text-orange-100 mb-8 text-lg">Read the docs, install the package, and start building reactive applications.</p>
      <div class="flex items-center justify-center gap-4">
        <a href="/getting-started/quick-start" class="px-6 py-3 bg-white text-orange-600 font-semibold rounded-xl hover:bg-orange-50 transition-colors shadow-lg">
          Quick Start Guide
        </a>
        <a href="/api/core" class="px-6 py-3 bg-orange-600 text-white font-semibold rounded-xl hover:bg-orange-700 transition-colors border border-orange-400">
          API Reference
        </a>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-gray-50 border-t border-gray-100 py-12">
    <div class="max-w-5xl mx-auto px-6 text-center text-sm text-gray-400">
      <p>Ripple.js — A standalone, framework-agnostic reactive utility library</p>
      <p class="mt-2">MIT License · <a href="https://github.com/Adityazzzzz/Ripple-JS" class="text-orange-500 hover:underline">GitHub</a> · <a href="https://www.npmjs.com/package/ripple-reactive" class="text-orange-500 hover:underline">npm</a></p>
    </div>
  </footer>

</body>
</html>
