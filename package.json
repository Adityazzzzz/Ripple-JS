{
  "name": "ripple-js",
  "version": "0.1.0",
  "description": "A standalone, framework-agnostic reactive utility library. One change ripples through all dependents.",
  "type": "module",
  "main": "dist/ripple.cjs.js",
  "module": "dist/ripple.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/ripple.esm.js",
      "require": "./dist/ripple.cjs.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": ["reactive", "signals", "computed", "effects", "state-management", "reactivity", "framework-agnostic"],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "rollup": "^4.18.0",
    "@rollup/plugin-typescript": "^11.1.6",
    "@rollup/plugin-terser": "^0.4.4",
    "tslib": "^2.6.3",
    "vitest": "^2.0.0",
    "rimraf": "^5.0.7"
  }
}
